rules_version = '2';

// Regras do Firestore da Roça Feliz.
// Cole este arquivo em Firebase Console > Firestore Database > Regras e clique em Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // "me" está na lista oficial de amigos de "uid" (farms/{uid}/amigos/{me})
    function amigoDe(uid) { return exists(/databases/$(database)/documents/farms/$(uid)/amigos/$(me())); }

    // Cada jogador tem uma roça. Só o dono salva. Podem ver: o dono, os amigos
    // (lista friends) e quem recebeu um pedido de amizade do dono (lista sent),
    // para poder espiar a roça antes de aceitar.
    match /farms/{uid} {
      allow read: if signedIn() && (me() == uid
                  || me() in resource.data.get('friends', [])
                  || me() in resource.data.get('sent', [])
                  || amigoDe(uid));
      allow write: if signedIn() && me() == uid
                   && request.resource.size() < 900000;

      // Visitas: o que um amigo fez na sua roça (ou um presente que mandou). Só amigos criam, sempre em
      // seu próprio nome. O dono lê e apaga ao aplicar.
      match /visits/{visitId} {
        allow create: if signedIn() && me() != uid
                      && request.resource.data.from == me()
                      && request.resource.data.t in ['help', 'steal', 'feed', 'stealA', 'stealF', 'gift', 'buy']
                      && request.resource.size() < 2000
                      && (me() in get(/databases/$(database)/documents/farms/$(uid)).data.get('friends', [])
                          || me() in get(/databases/$(database)/documents/farms/$(uid)).data.get('sent', [])
                          || amigoDe(uid));
        allow read, delete: if signedIn() && me() == uid;
      }

      // Chat: caixa de mensagens de cada um. O dono lê e apaga; quem manda grava na caixa do amigo
      // (só se forem amigos) e na própria. Texto curto, sempre no próprio nome.
      match /chat/{msgId} {
        allow read, delete: if signedIn() && me() == uid;
        allow create: if signedIn() && request.resource.data.de == me()
                      && request.resource.data.txt is string
                      && request.resource.data.txt.size() > 0 && request.resource.data.txt.size() <= 300
                      && request.resource.data.size() < 8
                      && (me() == uid
                          || me() in get(/databases/$(database)/documents/farms/$(uid)).data.get('friends', [])
                          // quem pediu a amizade (lista sent) já pode receber mensagem de quem aceitou,
                          // mesmo antes do jogo dele perceber que o pedido foi aceito
                          || me() in get(/databases/$(database)/documents/farms/$(uid)).data.get('sent', [])
                          || amigoDe(uid));
      }

      // Cópias de segurança da roça (uma por dia). Só o dono.
      match /backups/{dia} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid && request.resource.data.size() < 8;
      }

      // Lista oficial de amigos: só o dono escreve (ao virar amigo ou ao Excluir).
      // O dono e o próprio amigo podem ler (para cada um confirmar que a amizade continua).
      match /amigos/{amigoUid} {
        allow read: if signedIn() && (me() == uid || me() == amigoUid);
        allow create, update: if signedIn() && me() == uid && amigoUid != uid && request.resource.data.size() < 5;
        allow delete: if signedIn() && me() == uid;
      }

      // Pedidos de amizade: farms/{quemRecebe}/requests/{quemPediu}.
      // Quem pede cria (ou cancela) o seu; quem recebe lê e aceita/recusa apagando.
      match /requests/{fromUid} {
        allow create, update: if signedIn() && me() == fromUid && fromUid != uid
                              && request.resource.data.from == me()
                              && request.resource.size() < 2000;
        allow read, delete: if signedIn() && (me() == uid || me() == fromUid);
      }
    }

    // Notificações: cada um guarda os próprios aparelhos (tokens), preferências e a agenda.
    match /push/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid && request.resource.data.size() < 12;
    }
    // Avisos para outra pessoa (visita, presente, pedido de amizade). Ninguém lê pelo jogo:
    // o programinha de notificações entrega e apaga.
    match /avisos/{id} {
      allow create: if signedIn() && request.resource.data.de == me()
                    && request.resource.data.para is string && (request.resource.data.para != me() || request.resource.data.tipo == 'teste')
                    && request.resource.data.txt is string && request.resource.data.txt.size() < 200
                    && request.resource.data.size() < 8;
    }

    // Presença: só "online" e a hora da última vez visto. Qualquer jogador logado pode ler; cada um só grava o seu.
    match /presenca/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid && request.resource.data.size() <= 2;
    }

    // Ranking semanal: pontos da semana de cada jogador. Todos logados leem; cada um grava o seu.
    match /ranking/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && me() == uid && request.resource.data.size() < 10
                   && request.resource.data.pts is int && request.resource.data.pts < 100000;
    }

    // Códigos de amigo (6 letras) apontando para o jogador. Não podem ser trocados depois.
    match /codes/{code} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == me()
                    && code.size() == 6;
    }
  }
}
