{
  "rules": {
    ".read": false,
    ".write": false,
    "praca": {
      "ping": {
        ".read": "auth != null"
      },
      "jogadores": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'fu', 'fv', 'tu', 'tv'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "a": {
            "$k": {
              ".validate": "(newData.isString() && newData.val().length < 24) || newData.isNumber() || newData.isBoolean()"
            }
          },
          "fu": {
            ".validate": "newData.isNumber()"
          },
          "fv": {
            ".validate": "newData.isNumber()"
          },
          "tu": {
            ".validate": "newData.isNumber()"
          },
          "tv": {
            ".validate": "newData.isNumber()"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "ek": {
            ".validate": "newData.isString() && newData.val().length <= 4"
          },
          "et": {
            ".validate": "newData.isNumber()"
          },
          "$outro": {
            ".validate": false
          },
          "ia": {
            ".validate": "newData.isString() && newData.val().length <= 10"
          },
          "ic": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "iz": {
            ".validate": "newData.isNumber()"
          },
          "lv": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
          },
          "ft": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "sl": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "mo": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "tt": {
            ".validate": "newData.isString() && newData.val().length <= 28"
          },
          "sb": {
            ".validate": "newData.isString() && newData.val().length <= 16"
          },
          "pt": {
            ".validate": "newData.isString() && newData.val().length <= 6"
          }
        }
      },
      "chat": {
        ".read": "auth != null",
        ".indexOn": [
          "ts"
        ],
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && data.child('ts').val() < now - 86400000))",
          ".validate": "newData.hasChildren(['u', 'n', 't', 'ts'])",
          "u": {
            ".validate": "newData.val() === auth.uid"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "t": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
          },
          "ts": {
            ".validate": "newData.val() === now"
          },
          "$outro": {
            ".validate": false
          }
        }
      },
      "missao": {
        ".read": "auth != null",
        "$dia": {
          "$ev": {
            ".write": "auth != null",
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 100"
          }
        }
      },
      "boss": {
        ".read": "auth != null",
        "$slot": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 40"
        }
      },
      "rank": {
        ".read": "auth != null",
        "$dia": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 'p'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "p": {
              ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 300"
            },
            "$outro": {
              ".validate": false
            }
          }
        }
      },
      "mercado": {
        ".read": "auth != null",
        ".indexOn": [
          "ts"
        ],
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid) || (data.exists() && !newData.exists() && data.child('u').val() === auth.uid) || (data.exists() && newData.exists() && !data.child('c').exists() && newData.child('c').val() === auth.uid && newData.child('u').val() === data.child('u').val() && newData.child('p').val() === data.child('p').val() && newData.child('q').val() === data.child('q').val() && newData.child('i').val() === data.child('i').val()))",
          ".validate": "newData.hasChildren(['u', 'n', 'i', 'q', 'p', 'ts'])",
          "u": {
            ".validate": "newData.isString()"
          },
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "i": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "q": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
          },
          "p": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "c": {
            ".validate": "newData.isString()"
          },
          "$outro": {
            ".validate": false
          }
        }
      },
      "casas": {
        ".read": "auth != null",
        ".indexOn": [
          "ts"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'sk', 'ts'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "sk": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "d": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 6"
            }
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$outro": {
            ".validate": false
          }
        }
      },
      "inter": {
        "$alvo": {
          ".read": "auth != null && auth.uid === $alvo",
          "$de": {
            ".read": "auth != null && auth.uid === $de",
            ".write": "auth != null && (auth.uid === $de || auth.uid === $alvo)",
            ".validate": "newData.hasChildren(['n', 'k', 'ts'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "k": {
              ".validate": "newData.isString() && newData.val().length <= 10"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "ok": {
              ".validate": "newData.isNumber()"
            },
            "$outro": {
              ".validate": false
            }
          }
        }
      },
      "mundo": {
        ".read": "auth != null",
        "$slot": {
          "$i": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
            ".validate": "newData.isString() && newData.val() === auth.uid"
          }
        }
      },
      "salas": {
        "$sid": {
          "jog": {
            ".read": "auth != null",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.hasChildren(['n', 'fu', 'fv', 'tu', 'tv'])",
              "n": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "a": {
                "$k": {
                  ".validate": "(newData.isString() && newData.val().length < 24) || newData.isNumber() || newData.isBoolean()"
                }
              },
              "fu": {
                ".validate": "newData.isNumber()"
              },
              "fv": {
                ".validate": "newData.isNumber()"
              },
              "tu": {
                ".validate": "newData.isNumber()"
              },
              "tv": {
                ".validate": "newData.isNumber()"
              },
              "ts": {
                ".validate": "newData.isNumber()"
              },
              "ek": {
                ".validate": "newData.isString() && newData.val().length <= 4"
              },
              "et": {
                ".validate": "newData.isNumber()"
              },
              "$outro": {
                ".validate": false
              },
              "ia": {
                ".validate": "newData.isString() && newData.val().length <= 10"
              },
              "ic": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "iz": {
                ".validate": "newData.isNumber()"
              },
              "lv": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
              },
              "ft": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "sl": {
                ".validate": "newData.isString() && newData.val().length <= 24"
              },
              "mo": {
                ".validate": "newData.isString() && newData.val().length <= 20"
              },
              "tt": {
                ".validate": "newData.isString() && newData.val().length <= 28"
              },
              "sb": {
                ".validate": "newData.isString() && newData.val().length <= 16"
              },
              "pt": {
                ".validate": "newData.isString() && newData.val().length <= 6"
              }
            }
          }
        }
      },
      "quartos": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'a', 'ts'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "p": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 20"
          },
          "c": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 20"
          },
          "a": {
            ".validate": "newData.isString() && (newData.val() === 'todos' || newData.val() === 'amigos' || newData.val() === 'fechado')"
          },
          "m": {
            "$k": {
              ".validate": "$k.matches(/^[0-9]{1,2}$/) && newData.hasChildren(['i', 'u', 'v'])",
              "i": {
                ".validate": "newData.isString() && newData.val().length <= 12"
              },
              "u": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12"
              },
              "v": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 12"
              },
              "r": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
              },
              "$outro": {
                ".validate": false
              }
            }
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$outro": {
            ".validate": false
          }
        },
        ".indexOn": [
          "ts"
        ]
      },
      "presenca": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'l', 'ts'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "l": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$outro": {
            ".validate": false
          }
        }
      },
      "jogos": {
        ".read": "auth != null",
        "$id": {
          ".write": "auth != null && (!data.exists() || data.child('j1/u').val() === auth.uid || data.child('j2/u').val() === auth.uid || !data.child('j2').exists())",
          ".validate": "newData.hasChildren(['j1', 'b', 't', 'ts'])",
          "j1": {
            "u": {
              ".validate": "newData.isString()"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            }
          },
          "j2": {
            "u": {
              ".validate": "newData.isString()"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            }
          },
          "b": {
            ".validate": "newData.isString() && newData.val().length === 64"
          },
          "t": {
            ".validate": "newData.val() === 1 || newData.val() === 2"
          },
          "w": {
            ".validate": "newData.val() === 0 || newData.val() === 1 || newData.val() === 2"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$outro": {
            ".validate": false
          }
        }
      },
      "cartas": {
        "$dono": {
          ".read": "auth != null && auth.uid === $dono",
          ".indexOn": [
            "ts"
          ],
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('de').val() === auth.uid) || (data.exists() && auth.uid === $dono))",
            ".validate": "newData.hasChildren(['de', 'n', 't', 'ts'])",
            "de": {
              ".validate": "newData.isString()"
            },
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
            },
            "p": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$outro": {
              ".validate": false
            }
          }
        }
      },
      "voz": {
        ".read": "auth != null",
        "$sala": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber()"
          }
        }
      },
      "vozsinal": {
        "$para": {
          ".read": "auth != null && auth.uid === $para",
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('de').val() === auth.uid) || (data.exists() && auth.uid === $para))",
            ".validate": "newData.hasChildren(['de', 'k', 'd', 'ts'])",
            "de": {
              ".validate": "newData.val() === auth.uid"
            },
            "k": {
              ".validate": "newData.val() === 'offer' || newData.val() === 'answer' || newData.val() === 'ice'"
            },
            "d": {
              ".validate": "newData.isString() && newData.val().length <= 6000"
            },
            "ts": {
              ".validate": "newData.val() === now"
            },
            "$outro": {
              ".validate": false
            }
          }
        }
      },
      "dizimo": {
        ".read": "auth != null",
        ".indexOn": [
          "v"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['n', 'v'])",
          "n": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "v": {
            ".validate": "newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 50000"
          },
          "ts": {
            ".validate": "newData.isNumber()"
          },
          "$outro": {
            ".validate": false
          }
        }
      },
      "intencoes": {
        ".read": "auth != null",
        "$ciclo": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['n', 't', 'ts'])",
            "n": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "t": {
              ".validate": "newData.isString() && newData.val().length <= 140"
            },
            "ts": {
              ".validate": "newData.isNumber()"
            },
            "$outro": {
              ".validate": false
            }
          }
        }
      }
    }
  }
}